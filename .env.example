DATABASE_URL=postgresql://localhost/mcp_juridico
# Chave vigente: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
CACHE_TTL_SECONDS=3600
HTTP_OPEN_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2
HTTP_MIN_INTERVAL_SECONDS=1
HTTP_MAX_RETRY_WAIT_SECONDS=30
HTTP_USER_AGENT='MCP-Juridico/0.1 (configure-contato-institucional)'
# Auditoria de respostas publicas validadas, somente no banco privado.
STORE_RAW_PAYLOAD=false
# Opcional: arquivo para coleta textfile do Prometheus; nunca stdout.
METRICS_PATH=
# Banco isolado e descartavel para testes de integracao:
TEST_DATABASE_URL=
