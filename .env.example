# PostgreSQL / Supabase
DATABASE_URL='postgresql'


# API Pública do DataJud/CNJ
# Chave vigente:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY='COLE_AQUI_A_CHAVE_PUBLICA_VIGENTE'

# Cache
CACHE_TTL_SECONDS=3600

# HTTP
HTTP_OPEN_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=90
HTTP_MAX_RETRIES=1
HTTP_MIN_INTERVAL_SECONDS=3
HTTP_MAX_RETRY_WAIT_SECONDS=60

# Identificação do consumidor da API
HTTP_USER_AGENT='MCP-Juridico/0.1 (contato: seu-email@pge.mt.gov.br)'

# Auditoria
STORE_RAW_PAYLOAD=false

# Opcional: métricas Prometheus
METRICS_PATH=

# Somente para testes de integração em banco descartável
TEST_DATABASE_URL=
# Deadline total por índice na sondagem sem banco (segundos):
HEALTH_DATAJUD_TIMEOUT_SECONDS=10
# Matriz opcional de smoke tests (CNJs completos, sem valores reais versionados):
TRF1_CNJ=
TJMT_CNJ=
STJ_CNJ=
STF_CNJ=
