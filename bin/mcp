#!/usr/bin/env ruby
# frozen_string_literal: true
require_relative '../boot'
begin
  server, repository = Juridico.build
  MCP::Server::Transports::StdioTransport.new(server).open
rescue Juridico::Error => error
  warn JSON.generate(evento: 'startup', status: 'error', code: error.code)
  exit 1
rescue StandardError
  warn JSON.generate(evento: 'startup', status: 'error', code: 'internal_error')
  exit 1
ensure
  repository&.close
end
